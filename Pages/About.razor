@page "/about"

<PageTitle>@PageHeading | PeregrinoBits</PageTitle>

<div class="page-wrapper">
    <div class="content-container text-block">
        <h1>@TitleText</h1>
        
        <p>@Paragraph1</p>
        <p>@Paragraph2</p>
        <p>@Paragraph3</p>

        <div class="contact-section mt-4">
        <a href="mailto:@(EmailPrefix + EmailDomain)" class="btn btn-outline-light">
            @ContactText
        </a>
        </div>
    </div>
 
</div>

@code {
    // This connects the page to the language toggle in the MainLayout
    [CascadingParameter]
    public string CurrentLanguage { get; set; } = "EN";

    private string EmailPrefix = "contact";
    private string EmailDomain = "@peregrinobits.com";
    // --- Translations using C# Switch Expressions ---

    private string PageHeading => CurrentLanguage switch {
        "ES" => "Acerca de",
        "PT" => "Sobre",
        "FR" => "À propos",
        _ => "About"
    };

    private string ContactText => CurrentLanguage switch {
        "ES" => "Contactar al Proyecto",
        "PT" => "Contatar o Projeto",
        "FR" => "Contacter le Projet",
        _ => "Contact the Project"
    };

    private string TitleText => CurrentLanguage switch {
        "ES" => "Acerca del Proyecto",
        "PT" => "Sobre o Projeto",
        "FR" => "À propos du Projet",
        _ => "About the Project"
    };

    private string Paragraph1 => CurrentLanguage switch {
        "ES" => "PeregrinoBits se estableció con una misión central: promover la alfabetización sobre criptomonedas y defender los principios de la autosuficiencia financiera. En un mundo cada vez más digital, la verdadera soberanía aún depende de la capacidad fundamental de poseer tus propias llaves.",
        "PT" => "PeregrinoBits foi criado com uma missão central: promover a alfabetização em criptomoedas e defender os princípios de autossuficiência financeira. Em um mundo cada vez mais digital, a verdadeira soberania ainda depende da habilidade fundamental de guardar suas próprias chaves.",
        "FR" => "PeregrinoBits a été créé avec une mission centrale : promouvoir la culture des cryptomonnaies et défendre les principes de l'autonomie financière. Dans un monde de plus en plus numérique, la véritable souveraineté repose toujours sur la capacité fondamentale de détenir ses propres clés.",
        _ => "PeregrinoBits was established with a core mission: to promote cryptocurrency literacy and champion the principles of financial self-sufficiency. In an increasingly digital world, true sovereignty still relies on the fundamental ability to hold your own keys."
    };

    private string Paragraph2 => CurrentLanguage switch {
        "ES" => "Al utilizar almacenamiento en frío físico y no electrónico, esta iniciativa tiene como objetivo desmitificar la autocustodia. Transforma conceptos digitales abstractos en activos tangibles y seguros que cualquiera puede entender y sostener físicamente.",
        "PT" => "Ao utilizar armazenamento a frio físico e não eletrônico, esta iniciativa visa desmistificar a autocustódia. Ela transforma conceitos digitais abstratos em ativos tangíveis e seguros que qualquer pessoa pode entender e segurar fisicamente.",
        "FR" => "En utilisant un stockage à froid physique et non électronique, cette initiative vise à démystifier l'auto-conservation. Elle transforme des concepts numériques abstraits en actifs tangibles et sûrs que chacun peut comprendre et tenir entre ses mains.",
        _ => "By utilizing physical, non-electronic cold storage, this initiative aims to demystify self-custody. It transforms abstract digital concepts into tangible, secure assets that anyone can understand and physically hold."
    };

    private string Paragraph3 => CurrentLanguage switch {
        "ES" => "Más allá del hardware, este proyecto está diseñado para cerrar la brecha entre las redes virtuales globales y las comunidades físicas del mundo real. Al llevar la Edición Peregrino a pie a lo largo del Camino de Santiago y entregarla directamente a otros peregrinos, PeregrinoBits conecta el espíritu descentralizado y sin fronteras de Bitcoin con la resistencia compartida y la conexión humana de la antigua peregrinación.",
        "PT" => "Além do hardware, este projeto foi criado para preencher a lacuna entre as redes virtuais globais e as comunidades físicas do mundo real. Ao levar a Edição Peregrino a pé ao longo da trilha do Caminho de Santiago e entregá-la diretamente a outros peregrinos, PeregrinoBits conecta o ethos descentralizado e sem fronteiras do Bitcoin com a resistência compartilhada e a conexão humana da antiga peregrinação.",
        "FR" => "Au-delà du matériel, ce projet vise à combler l'écart entre les réseaux virtuels mondiaux et les communautés physiques du monde réel. En portant l'Édition Peregrino à pied le long du Chemin de Saint-Jacques et en la remettant directement aux autres pèlerins, PeregrinoBits relie l'éthique décentralisée et sans frontières du Bitcoin à l'endurance partagée et au lien humain de l'ancien pèlerinage.",
        _ => "Beyond the hardware, this project is designed to bridge the gap between global, virtual networks and physical, real-world communities. By carrying the Peregrino Edition by foot along the Camino de Santiago trail and giving it directly to fellow pilgrims, PeregrinoBits connects the decentralized, borderless ethos of Bitcoin with the shared endurance and human connection of the ancient pilgrimage."
    };
}