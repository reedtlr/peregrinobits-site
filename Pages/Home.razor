@page "/"

<PageTitle>PeregrinoBits | Camino Cold Storage</PageTitle>

<div class="page-wrapper">
    <header class="hero-section">
        <div class="hero-logo-container">
            <!-- Restored the original main logo -->
            <img src="images/logo.jpg" alt="PeregrinoBits Logo" class="hero-logo" />
        </div>
        <div class="hero-text-container">
            <span class="badge">@BadgeText</span>
            <h1 class="main-title">Tus llaves. Tu camino.</h1>
            <p class="tagline">@TaglineText</p>
            <p class="description">@DescriptionText</p>

            <div class="cta-group">
                <button class="btn btn-primary disabled-btn" disabled>@BtnText</button>
            </div>
        </div>
    </header>

    <section class="update-section">
        <div class="update-content">
            <div class="production-update-box">
                <h2 class="status-title">@StatusTitle</h2>
                <p>@StatusParagraph</p>
            </div>
            <figure class="proof-figure">
                <img src="images/card-proof.jpg" alt="@ProofAlt" class="teaser-image" loading="lazy" />
                <figcaption class="proof-caption">@ProofCaption</figcaption>
            </figure>
        </div>
    </section>

    <section class="specs-grid" id="specs">
        <div class="spec-card">
            <div class="card-icon">⚡</div>
            <h3>@Spec1Title</h3>
            <p>@Spec1Desc</p>
        </div>
        <div class="spec-card">
            <div class="card-icon">🔒</div>
            <h3>@Spec2Title</h3>
            <p>@Spec2Desc</p>
        </div>
        <div class="spec-card">
            <div class="card-icon">🥾</div>
            <h3>@Spec3Title</h3>
            <p>@Spec3Desc</p>
        </div>
    </section>

    <section class="editions-section" id="editions">
        <h2>@EditionsTitle</h2>
        <p class="editions-intro">@EditionsIntro</p>

        <div class="editions-grid">
            <article class="edition-card edition-card-limited">
                <span class="edition-tag">@Edition1Tag</span>
                <h3>@Edition1Title</h3>
                <p>@Edition1Desc</p>
            </article>
            <article class="edition-card edition-card-peregrino">
                <span class="edition-tag">@Edition2Tag</span>
                <h3>@Edition2Title</h3>
                <p>@Edition2Desc</p>
            </article>
        </div>
    </section>

    <section class="ballet-section">
        <h2>@BalletTitle</h2>
        <p>@BalletDesc</p>

        <div class="ballet-links">
            <a href="@BitcoinOrgUrl" target="_blank" class="btn btn-outline">@BitcoinOrgLinkText</a>
            <a href="https://www.ballet.com/quick-start/" target="_blank" class="btn btn-outline">@BalletLink2</a>
        </div>
    </section>
</div>

<style>
    /* New styling for the dedicated update section */
    .update-section {
        margin: 3rem auto;
        max-width: 800px;
        text-align: center;
        padding: 0 1rem;
    }

    .teaser-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(255, 255, 255, 0.05);
    }

    .production-update-box {
        background: rgba(255, 255, 255, 0.05);
        border-left: 4px solid #d4af37; /* Accent color on the left edge */
        padding: 1.2rem 1.5rem;
        border-radius: 4px;
        text-align: left;
    }

    .production-update-box p {
        margin: 0;
        font-size: 1rem;
        line-height: 1.5;
    }

    .status-title {
        margin: 0 0 0.6rem 0;
        font-size: 1.15rem;
        color: #ffffff;
        font-weight: 700;
    }

    /* Digital proof placeholder image + its caption */
    .proof-figure {
        margin: 1.5rem 0 0 0;
    }

    .proof-caption {
        margin-top: 0.75rem;
        font-size: 0.85rem;
        color: #777777;
        font-style: italic;
    }

    /* Two Unique Editions */
    .editions-section {
        margin-top: 5rem;
        padding-top: 3rem;
        border-top: 1px solid #222222;
        text-align: center;
    }

    .editions-section h2 {
        color: #ffffff;
        margin-bottom: 1rem;
    }

    .editions-intro {
        color: #a0a0a0;
        max-width: 700px;
        margin: 0 auto 2.5rem auto;
        line-height: 1.6;
    }

    .editions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        text-align: left;
    }

    .edition-card {
        background-color: #111111;
        border: 1px solid #222222;
        border-top: 3px solid #d4af37; /* Gold: numbered collector run */
        padding: 2rem;
        border-radius: 10px;
    }

    .edition-card-peregrino {
        border-top-color: #4a73b8; /* Camino waymarker blue: trail-direct run */
    }

    .edition-tag {
        display: inline-block;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #d4af37;
        border: 1px solid #333333;
        border-radius: 20px;
        padding: 0.25rem 0.7rem;
        margin-bottom: 0.9rem;
    }

    .edition-card-peregrino .edition-tag {
        color: #8fb0e8;
    }

    .edition-card h3 {
        color: #ffffff;
        margin: 0 0 0.6rem 0;
        font-size: 1.3rem;
    }

    .edition-card p {
        color: #888888;
        line-height: 1.6;
        font-size: 0.95rem;
        margin: 0;
    }
</style>

@code {
    [CascadingParameter]
    public string CurrentLanguage { get; set; } = "EN";

    // --- Translations using C# Switch Expressions ---

    private string BadgeText => CurrentLanguage switch {
        "ES" => "Serie 1 • Edición Limitada",
        "PT" => "Série 1 • Edição Limitada",
        _ => "Series 1 • Limited Edition"
    };

    private string TaglineText => CurrentLanguage switch {
        "ES" => "UN CAMINO ANTIGUO. UN ESTÁNDAR MODERNO.",
        "PT" => "UM CAMINHO ANTIGO. UM PADRÃO MODERNO.",
        _ => "AN ANCIENT PATH. A MODERN STANDARD."
    };

    private string DescriptionText => CurrentLanguage switch {
        "ES" => "Uniendo el espíritu de la peregrinación del Camino de Santiago con la soberanía financiera moderna. Una edición limitada de almacenamiento en frío físico de Bitcoin.",
        "PT" => "Unindo o espírito da peregrinação do Caminho de Santiago à soberania financeira moderna. Uma edição limitada de armazenamento a frio físico de Bitcoin.",
        _ => "Bridging the spirit of the Camino de Santiago pilgrimage with modern financial sovereignty. A limited physical Bitcoin cold storage release."
    };

    private string StatusTitle => CurrentLanguage switch {
        "ES" => "Tarjetas en mano — fotos y lanzamiento muy pronto",
        "PT" => "Cartões em mãos — fotos e lançamento em breve",
