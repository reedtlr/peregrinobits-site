        _ => "The safest way to hold digital wealth is through pure, trustless cold storage. Peregrino Bits are built on Ballet's proven, non-electronic physical wallet infrastructure, eliminating the risks of hardware failure, malware, and digital hacking."
    };

 private string BitcoinOrgLinkText => CurrentLanguage switch {
        "ES" => "Seguridad de Clave Privada",
        "PT" => "Segurança da Chave Privada",
        _ => "Private Key Security"
    };

    private string BitcoinOrgUrl => CurrentLanguage switch {
        _ => "https://www.ballet.com/2FKG/"
    };

    private string BalletLink2 => CurrentLanguage switch {
        "ES" => "Guía de Inicio Rápido de Ballet",
        "PT" => "Guia de Início Rápido da Ballet",
        _ => "Ballet Quick Start Guide"
    };

    // --- Edition photography ---
    // One entry per photo: the file in wwwroot/images, then its EN / ES / PT alt text.
    // To swap a photo, drop the new file into wwwroot/images and change the name here.
    // The first photo in each list runs full width; the rest sit beneath it.

    private sealed record Shot(string File, string En, string Es, string Pt);

    private string AltFor(Shot shot) => CurrentLanguage switch {
        "ES" => shot.Es,
        "PT" => shot.Pt,
        _ => shot.En
    };

    private static readonly Shot[] LimitedShots = {
        new("limited-full.jpg",
            "Limited Edition card 001 with its stamped envelope and Certificate of Authenticity",
            "La tarjeta 001 de la Edición Limitada con su sobre estampado y su Certificado de Autenticidad",
            "O cartão 001 da Edição Limitada com seu envelope carimbado e seu Certificado de Autenticidade"),
        new("limited-detail.jpg",
            "Close-up of the serial number 001, hand-painted in gold on the card",
            "Primer plano del número de serie 001, pintado a mano en dorado sobre la tarjeta",
            "Close-up do número de série 001, pintado à mão em dourado sobre o cartão"),
        new("limited-seal.jpg",
            "Macro of the custom wax seal: a gold scallop shell over deep red wax",
