@page "/"

<PageTitle>PeregrinoBits | Camino Cold Storage</PageTitle>

<div class="page-wrapper">
    <header class="hero-section">
        <div class="hero-logo-container">
            <!-- Restored the original main logo -->
            <img src="images/logo.jpg" alt="PeregrinoBits Logo" class="hero-logo" />
        </div>
        <div class="hero-text-container">
            <span class="badge">@BadgeText</span>
            <h1 class="main-title">Tus llaves. Tu camino.</h1>
            <p class="tagline">@TaglineText</p>
            <p class="description">@DescriptionText</p>

            <p class="sale-note"><span class="sale-dot"></span>@SaleNote</p>
        </div>
    </header>

    <section class="specs-grid" id="specs">
        <div class="spec-card">
            <div class="card-icon">⚡</div>
            <h3>@Spec1Title</h3>
            <p>@Spec1Desc</p>
        </div>
        <div class="spec-card">
            <div class="card-icon">🔒</div>
            <h3>@Spec2Title</h3>
            <p>@Spec2Desc</p>
        </div>
        <div class="spec-card">
            <div class="card-icon">🥾</div>
            <h3>@Spec3Title</h3>
            <p>@Spec3Desc</p>
        </div>
    </section>

    <section class="editions-section" id="editions">
        <h2>@EditionsTitle</h2>
        <p class="editions-intro">@EditionsIntro</p>

        <div class="editions-grid">
            <article class="edition-card edition-card-limited">
                <span class="edition-tag">@Edition1Tag</span>
                <h3>@Edition1Title</h3>
                <p>@Edition1Desc</p>
                <p class="edition-note">@EditionNote</p>
                <div class="edition-gallery">
                    @foreach (var shot in LimitedShots)
                    {
                        <img src="images/@shot.File" alt="@AltFor(shot)" loading="lazy" />
                    }
                </div>
            </article>
            <article class="edition-card edition-card-peregrino">
                <span class="edition-tag">@Edition2Tag</span>
                <h3>@Edition2Title</h3>
                <p>@Edition2Desc</p>
                <div class="edition-gallery">
                    @foreach (var shot in PeregrinoShots)
                    {
                        <img src="images/@shot.File" alt="@AltFor(shot)" loading="lazy" />
                    }
                </div>
            </article>
        </div>
    </section>

    <section class="buy-section">
        <h2>@BuyTitle</h2>
        <p class="buy-price">@BuyPrice</p>

        <div class="cta-group">
            @if (!string.IsNullOrWhiteSpace(CardCheckoutUrl))
            {
                <a href="@CardCheckoutUrl" target="_blank" class="btn btn-primary">@CardBtnText</a>
            }
            <a href="@SaleThreadUrl" target="_blank" class="btn btn-primary">@BtnText</a>
        </div>
    </section>

    <section class="ballet-section">
        <h2>@BalletTitle</h2>
        <p>@BalletDesc</p>

        <figure class="ballet-figure">
            <img src="images/card-sample.jpg" alt="@SampleAlt" class="ballet-sample" loading="lazy" />
            <figcaption class="ballet-caption">@SampleCaption</figcaption>
        </figure>

        <div class="ballet-links">
            <a href="@BitcoinOrgUrl" target="_blank" class="btn btn-outline">@BitcoinOrgLinkText</a>
            <a href="https://www.ballet.com/quick-start/" target="_blank" class="btn btn-outline">@BalletLink2</a>
        </div>
    </section>
</div>

<style>
    /* "On sale now" line above the call to action */
    .sale-note {
        margin: 0 0 1.1rem 0;
        color: #d4af37;
        font-size: 0.95rem;
        font-weight: 600;
    }

    /* Inline, so it stays beside the text when the line wraps and follows
       the hero's text-align on narrow screens. */
    .sale-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        margin-right: 0.5rem;
        border-radius: 50%;
        background-color: #4ade80;
        vertical-align: middle;
    }

    /* Two Unique Editions */
    .editions-section {
        margin-top: 5rem;
        padding-top: 3rem;
        border-top: 1px solid #222222;
        text-align: center;
    }

    .editions-section h2 {
        color: #ffffff;
        margin-bottom: 1rem;
    }

    .editions-intro {
        color: #a0a0a0;
        max-width: 700px;
        margin: 0 auto 2.5rem auto;
        line-height: 1.6;
    }

    .editions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        text-align: left;
    }

    .edition-card {
        background-color: #111111;
        border: 1px solid #222222;
        border-top: 3px solid #d4af37; /* Gold: numbered collector run */
        padding: 2rem;
        border-radius: 10px;
    }

    .edition-card-peregrino {
        border-top-color: #4a73b8; /* Camino waymarker blue: trail-direct run */
    }

    .edition-tag {
        display: inline-block;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #d4af37;
        border: 1px solid #333333;
        border-radius: 20px;
        padding: 0.25rem 0.7rem;
        margin-bottom: 0.9rem;
    }

    .edition-card-peregrino .edition-tag {
        color: #8fb0e8;
    }

    .edition-card h3 {
        color: #ffffff;
        margin: 0 0 0.6rem 0;
        font-size: 1.3rem;
    }

    .edition-card p {
        color: #888888;
        line-height: 1.6;
        font-size: 0.95rem;
        margin: 0;
    }

    /* Pieces held back from the numbered run - deliberately quiet */
    .edition-card .edition-note {
        margin-top: 0.9rem;
        font-size: 0.82rem;
        line-height: 1.5;
        color: #6b6b6b;
    }

    /* Buy block: the ask, placed after the editions rather than in the hero */
    .buy-section {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid #222222;
        text-align: center;
    }

    .buy-section h2 {
        color: #ffffff;
        margin-bottom: 0.9rem;
    }

    .buy-price {
        max-width: 620px;
        margin: 0 auto 1.6rem auto;
        color: #a0a0a0;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .buy-section .cta-group {
        justify-content: center;
    }

    /* Sample card: what "non-electronic physical wallet" actually looks like */
    .ballet-figure {
        max-width: 560px;
        margin: 0 auto 2rem auto;
    }

    .ballet-sample {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .ballet-caption {
        margin-top: 0.9rem;
        color: #777777;
        font-size: 0.88rem;
        line-height: 1.6;
    }

    /* Edition photography: hero across the top, two details beneath */
    .edition-gallery {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        margin-top: 1.4rem;
    }

    .edition-gallery img {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #222222;
    }

    .edition-gallery img:first-child {
        grid-column: 1 / -1;
        aspect-ratio: 16 / 10;
    }
</style>

