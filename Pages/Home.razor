@page "/"

<PageTitle>PeregrinoBits | Camino Cold Storage</PageTitle>

<div class="page-wrapper">
    <header class="hero-section">
        <div class="hero-logo-container">
            <!-- Restored the original main logo -->
            <img src="images/logo.jpg" alt="PeregrinoBits Logo" class="hero-logo" />
        </div>
        <div class="hero-text-container">
            <span class="badge">@BadgeText</span>
            <h1 class="main-title">Tus llaves. Tu camino.</h1>
            <p class="tagline">@TaglineText</p>
            <p class="description">@DescriptionText</p>

            <div class="cta-group">
                <button class="btn btn-primary disabled-btn" disabled>@BtnText</button>
            </div>
        </div>
    </header>

    <section class="specs-grid" id="specs">
        <div class="spec-card">
            <div class="card-icon">⚡</div>
            <h3>@Spec1Title</h3>
            <p>@Spec1Desc</p>
        </div>
        <div class="spec-card">
            <div class="card-icon">🔒</div>
            <h3>@Spec2Title</h3>
            <p>@Spec2Desc</p>
        </div>
        <div class="spec-card">
            <div class="card-icon">🥾</div>
            <h3>@Spec3Title</h3>
            <p>@Spec3Desc</p>
        </div>
    </section>

    <section class="editions-section" id="editions">
        <h2>@EditionsTitle</h2>
        <p class="editions-intro">@EditionsIntro</p>

        <div class="editions-grid">
            <article class="edition-card edition-card-limited">
                <span class="edition-tag">@Edition1Tag</span>
                <h3>@Edition1Title</h3>
                <p>@Edition1Desc</p>
                <p class="edition-note">@EditionNote</p>
                <div class="edition-gallery">
                    @foreach (var shot in LimitedShots)
                    {
                        <img src="images/@shot.File" alt="@AltFor(shot)" loading="lazy" />
                    }
                </div>
            </article>
            <article class="edition-card edition-card-peregrino">
                <span class="edition-tag">@Edition2Tag</span>
                <h3>@Edition2Title</h3>
                <p>@Edition2Desc</p>
                <div class="edition-gallery">
                    @foreach (var shot in PeregrinoShots)
                    {
                        <img src="images/@shot.File" alt="@AltFor(shot)" loading="lazy" />
                    }
                </div>
            </article>
        </div>
    </section>

    <section class="ballet-section">
        <h2>@BalletTitle</h2>
        <p>@BalletDesc</p>

        <div class="ballet-links">
            <a href="@BitcoinOrgUrl" target="_blank" class="btn btn-outline">@BitcoinOrgLinkText</a>
            <a href="https://www.ballet.com/quick-start/" target="_blank" class="btn btn-outline">@BalletLink2</a>
        </div>
    </section>
</div>

<style>
    /* Two Unique Editions */
    .editions-section {
        margin-top: 5rem;
        padding-top: 3rem;
        border-top: 1px solid #222222;
        text-align: center;
    }

    .editions-section h2 {
        color: #ffffff;
        margin-bottom: 1rem;
    }

    .editions-intro {
        color: #a0a0a0;
        max-width: 700px;
        margin: 0 auto 2.5rem auto;
        line-height: 1.6;
    }

    .editions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        text-align: left;
    }

    .edition-card {
        background-color: #111111;
        border: 1px solid #222222;
        border-top: 3px solid #d4af37; /* Gold: numbered collector run */
        padding: 2rem;
        border-radius: 10px;
    }

    .edition-card-peregrino {
        border-top-color: #4a73b8; /* Camino waymarker blue: trail-direct run */
    }

    .edition-tag {
        display: inline-block;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #d4af37;
        border: 1px solid #333333;
        border-radius: 20px;
        padding: 0.25rem 0.7rem;
        margin-bottom: 0.9rem;
    }

    .edition-card-peregrino .edition-tag {
        color: #8fb0e8;
    }

    .edition-card h3 {
        color: #ffffff;
        margin: 0 0 0.6rem 0;
        font-size: 1.3rem;
    }

    .edition-card p {
        color: #888888;
        line-height: 1.6;
        font-size: 0.95rem;
        margin: 0;
    }

    /* Pieces held back from the numbered run - deliberately quiet */
    .edition-card .edition-note {
        margin-top: 0.9rem;
        font-size: 0.82rem;
        line-height: 1.5;
        color: #6b6b6b;
    }

    /* Edition photography: hero across the top, two details beneath */
    .edition-gallery {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        margin-top: 1.4rem;
    }

    .edition-gallery img {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #222222;
    }

    .edition-gallery img:first-child {
        grid-column: 1 / -1;
        aspect-ratio: 16 / 10;
    }
</style>

@code {
    [CascadingParameter]
    public string CurrentLanguage { get; set; } = "EN";

    // --- Translations using C# Switch Expressions ---

    private string BadgeText => CurrentLanguage switch {
        "ES" => "Serie 1 • Edición Limitada",
        "PT" => "Série 1 • Edição Limitada",
        _ => "Series 1 • Limited Edition"
    };

    private string TaglineText => CurrentLanguage switch {
        "ES" => "UN CAMINO ANTIGUO. UN ESTÁNDAR MODERNO.",
        "PT" => "UM CAMINHO ANTIGO. UM PADRÃO MODERNO.",
        _ => "AN ANCIENT PATH. A MODERN STANDARD."
    };

    private string DescriptionText => CurrentLanguage switch {
        "ES" => "Uniendo el espíritu de la peregrinación del Camino de Santiago con la soberanía financiera moderna. Una edición limitada de almacenamiento en frío físico de Bitcoin.",
        "PT" => "Unindo o espírito da peregrinação do Caminho de Santiago à soberania financeira moderna. Uma edição limitada de armazenamento a frio físico de Bitcoin.",
        _ => "Bridging the spirit of the Camino de Santiago pilgrimage with modern financial sovereignty. A limited physical Bitcoin cold storage release."
    };

    private string BtnText => CurrentLanguage switch {
        "ES" => "Lanzamiento en Bitcointalk: Próximamente",
        "PT" => "Lançamento no Bitcointalk: Em Breve",
        _ => "Bitcointalk Launch: Coming Soon"
    };

    private string Spec1Title => CurrentLanguage switch {
        "ES" => "Escasez Estricta",
        "PT" => "Escassez Rigorosa",
        _ => "Strict Scarcity"
    };

private string Spec1Desc => CurrentLanguage switch {
        "ES" => "La Edición Limitada de la Serie 1 está limitada a 100 unidades, numeradas a mano con tinta metálica dorada de archivo. Cada tarjeta se envía sellada a mano en un sobre de presentación, con un Certificado de Autenticidad conmemorativo y un sello de cera personalizado que recuerda a los que se recogen a lo largo del Camino.",
        "PT" => "A Edição Limitada da Série 1 está limitada a 100 unidades, numeradas à mão com tinta metálica dourada de arquivo. Cada cartão é enviado lacrado à mão em um envelope de apresentação, com um Certificado de Autenticidade comemorativo e um selo de cera personalizado que lembra os coletados ao longo do Caminho.",
        _ => "The Series 1 Limited Edition is capped at 100 units, hand-numbered in archival gold metallic ink. Every card ships hand-sealed in a presentation envelope with a commemorative Certificate of Authenticity and a custom wax stamp reminiscent of the ones collected along the trail."
    };

    private string Spec2Title => CurrentLanguage switch {
        "ES" => "Descargado y Seguro",
        "PT" => "Descarregado e Seguro",
        _ => "Unloaded & Safe"
    };

    private string Spec2Desc => CurrentLanguage switch {
        "ES" => "Se envía completamente descargado (saldo cero) para la autocustodia sin confianza y sin fricción regulatoria.",
        "PT" => "Enviado completamente descarregado (saldo zero) para autocustódia sem necessidade de confiança e sem atrito regulatório.",
        _ => "Ships completely unloaded (zero balance) for trustless self-custody and zero regulatory friction."
    };

    private string Spec3Title => CurrentLanguage switch {
        "ES" => "Distribuido a Pie",
        "PT" => "Distribuído a Pé",
        _ => "Distributed by Foot"
    };

    private string Spec3Desc => CurrentLanguage switch {
        "ES" => "La Edición Peregrino nunca se vende en línea. Se lleva a pie por el Camino y se entrega directamente a los peregrinos que se encuentran en el trayecto.",
        "PT" => "A Edição Peregrino nunca é vendida online. Ela é levada a pé pelo Caminho e entregue diretamente aos peregrinos encontrados no percurso.",
        _ => "The Peregrino Edition is never sold online. It is carried along the Camino on foot and given directly to fellow pilgrims met along the way."
    };

    private string EditionsTitle => CurrentLanguage switch {
        "ES" => "Dos Ediciones Únicas",
        "PT" => "Duas Edições Únicas",
        _ => "Two Unique Editions"
    };

    private string EditionsIntro => CurrentLanguage switch {
        "ES" => "Para honrar tanto al coleccionista como al viaje, las billeteras físicas están disponibles en dos formatos distintos.",
        "PT" => "Para honrar tanto o colecionador quanto a jornada, as carteiras físicas estão disponíveis em dois formatos distintos.",
        _ => "To honor both the collector and the journey, the physical wallets are available in two distinct formats."
    };

    private string Edition1Tag => CurrentLanguage switch {
        "ES" => "En línea",
        "PT" => "Online",
        _ => "Online"
    };

    private string Edition1Title => CurrentLanguage switch {
        "ES" => "Edición Limitada",
        "PT" => "Edição Limitada",
        _ => "Limited Edition"
    };

    private string Edition1Desc => CurrentLanguage switch {
        "ES" => "Estrictamente limitada a 100 unidades en todo el mundo. Cada billetera está numerada secuencialmente a mano (001) para garantizar su procedencia y se presenta con un sello de cera estampado a mano.",
        "PT" => "Estritamente limitada a 100 unidades em todo o mundo. Cada carteira é numerada sequencialmente à mão (001) para garantir a procedência e é apresentada com um selo de cera carimbado à mão.",
        _ => "Strictly limited to 100 units worldwide. Each wallet is sequentially hand-numbered (001) for provenance and packaged with a custom hand-stamped wax seal."
    };

    private string EditionNote => CurrentLanguage switch {
        "ES" => "Fuera de la edición numerada: el número 000 y tres Pruebas de Artista (AP) con diseños modificados, conservados por el creador. Una AP podría subastarse más adelante.",
        "PT" => "Fora da edição numerada: o número 000 e três Provas de Artista (AP) com designs alterados, mantidos pelo criador. Uma AP poderá ser leiloada futuramente.",
        _ => "Held outside the numbered edition: number 000 and three Artist Proofs (AP) with altered designs, retained by the maker. An AP may be auctioned at a later date."
    };

    private string Edition2Tag => CurrentLanguage switch {
        "ES" => "Directo del Camino",
        "PT" => "Direto do Caminho",
        _ => "Trail Direct"
    };

    private string Edition2Title => CurrentLanguage switch {
        "ES" => "Edición Peregrino",
        "PT" => "Edição Peregrino",
        _ => "Peregrino Edition"
    };

    private string Edition2Desc => CurrentLanguage switch {
        "ES" => "Nunca se vende en línea. Se lleva y se entrega estrictamente a pie a otros viajeros del Camino. En lugar de un número de serie, cada una lleva la inscripción «Ultreia» —el saludo tradicional del peregrino que significa «¡Adelante!»— y se remata con el mismo sello de cera personalizado.",
        "PT" => "Nunca vendidas online. São levadas e distribuídas estritamente a pé a outros viajantes do Caminho. Em vez de um número de série, cada uma traz a inscrição “Ultreia” — a saudação tradicional do peregrino que significa “Avante!” — e é finalizada com o mesmo selo de cera personalizado.",
        _ => "Never sold online. These are carried and distributed strictly by foot to fellow travelers on the trail. Instead of a serial number, each is inscribed with “Ultreia” — the traditional pilgrim greeting meaning “Onward!” — and finished with the same custom wax seal."
