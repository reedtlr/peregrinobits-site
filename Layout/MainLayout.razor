@inherits LayoutComponentBase
@inject IJSRuntime JS

<CascadingValue Value="CurrentLanguage">
    <div class="app-container">
        <header class="top-nav">
            <div class="lang-toggle">
                <button class="btn-lang @(CurrentLanguage == "EN" ? "active" : "")" @onclick="@(() => SetLanguage("EN"))">EN</button>
                <span class="divider">|</span>
                <button class="btn-lang @(CurrentLanguage == "ES" ? "active" : "")" @onclick="@(() => SetLanguage("ES"))">ES</button>
                <span class="divider">|</span>
                <button class="btn-lang @(CurrentLanguage == "PT" ? "active" : "")" @onclick="@(() => SetLanguage("PT"))">PT</button>
                <span class="divider">|</span>
                <button class="btn-lang @(CurrentLanguage == "FR" ? "active" : "")" @onclick="@(() => SetLanguage("FR"))">FR</button>
            </div>

            <div class="nav-links">
                <a href="/" class="nav-link">@HomeLink</a>
                <a href="/about" class="nav-link">@AboutLink</a>
            </div>
        </header>

        <main class="content-body">
            @Body
        </main>

        <footer class="site-footer">
            <p>&copy; 2026 PeregrinoBits • Autonomous Cold Storage</p>
        </footer>
    </div>
</CascadingValue>

@code {
    private string CurrentLanguage { get; set; } = "EN";

    // Picks up a previously chosen language, else the browser's own preference.
    // English if neither is usable.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var detected = await JS.InvokeAsync<string>("peregrinoBits.pickLanguage");
            if (!string.IsNullOrEmpty(detected))
            {
                CurrentLanguage = detected;
            }
        }
        catch
        {
            // Script blocked or missing - English is a fine fallback.
        }
    }

    private async Task SetLanguage(string lang)
    {
        CurrentLanguage = lang;

        try
        {
            await JS.InvokeVoidAsync("peregrinoBits.rememberLanguage", lang);
        }
        catch
        {
            // Remembering is a nicety; the toggle still works without it.
        }
    }

    private string HomeLink => CurrentLanguage switch {
        "ES" => "Inicio",
        "PT" => "Início",
        "FR" => "Accueil",
        _ => "Home"
    };

    private string AboutLink => CurrentLanguage switch {
        "ES" => "Acerca de",
        "PT" => "Sobre",
        "FR" => "À propos",
        _ => "About"
    };
}